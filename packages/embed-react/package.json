{
  "name": "@cooeehq/react",
  "version": "0.2.0",
  "description": "Drop-in React component for Cooee changelogs — a \"Latest updates\" popup powered by your public feed.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://cooee.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cooeehq/cooee.git",
    "directory": "packages/embed-react"
  },
  "keywords": [
    "react",
    "changelog",
    "release-notes",
    "whats-new",
    "widget",
    "cooee"
  ],
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "marked": "^18.0.5"
  },
  "devDependencies": {
    "@mixmark-io/domino": "2.2.0",
    "@cooee/shared": "workspace:*",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
