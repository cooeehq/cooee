{
  "name": "cooee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@hono/node-server": "2.0.11",
    "@opentelemetry/core": "2.10.0",
    "brace-expansion": "5.0.9",
    "dompurify": "3.4.13",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "ip-address": "10.4.0",
    "js-yaml": "4.3.1",
    "minimatch": "10.2.5",
    "nanoid": "3.3.18",
    "next": "16.2.11",
    "postcss": "8.5.25",
    "react-router": "8.3.0",
    "sharp": "0.35.3",
    "undici": "7.29.0",
    "ws": "8.21.0"
  },
  "scripts": {
    "build": "bun run --filter='*' build",
    "check": "bun run typecheck && bun test",
    "dev": "COOEE_API_PORT=3100 APP_URL=http://localhost:5173 BETTER_AUTH_URL=http://localhost:5173 bun run --filter @cooee/api --filter @cooee/admin dev",
    "dev:api": "bun --filter @cooee/api dev",
    "dev:admin": "bun --filter @cooee/admin dev",
    "format": "prettier --write .",
    "lint": "eslint .",
    "migrate": "bun --filter @cooee/api migrate",
    "custom-domain-worker:deploy": "bun --filter @cooee/custom-domain-worker deploy",
    "changelog:historical": "bun --filter @cooee/api cron:historical",
    "railway:cron": "bun --filter @cooee/api cron:daily",
    "test": "bun test",
    "typecheck": "tsc -p packages/shared && tsc -p packages/embed-react && tsc -p packages/cli && tsc -p apps/api && tsc -p apps/mcp --noEmit && tsc -p apps/admin"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/bun": "latest",
    "@types/node": "^20.19.0",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@tiptap/extension-link": "3.26.0",
    "@tiptap/extension-image": "3.26.0",
    "@tiptap/extension-table": "3.26.0",
    "@tiptap/react": "3.26.0",
    "@tiptap/starter-kit": "3.26.0",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cuelume": "^0.1.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.1",
    "geist": "^1.7.2",
    "lucide-react": "^0.555.0",
    "marked": "18.0.5",
    "openai": "^6.46.0",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "stripe": "^20.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "vaul": "^1.1.2",
    "zod": "^4.1.13"
  }
}
