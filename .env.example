# App
APP_URL=http://localhost:3000
PORT=3000
# Set hosted in production to fail closed even outside Railway.
COOEE_RUNTIME_MODE=
# Enable only on the managed app.cooee.sh API. This lets npx cooee-changelog
# create a short-lived browser setup session; self-hosted deployments leave it false.
COOEE_CLI_SETUP_ENABLED=false
NODE_ENV=development
# Railway defaults to its documented X-Real-IP header. Elsewhere, only set this
# when the hosting edge strips incoming copies and supplies a validated IP.
TRUSTED_CLIENT_IP_HEADER=

# Read-only MCP service (separate Railway service).
COOEE_API_BASE_URL=http://localhost:3000
MCP_URL=http://localhost:3001
# Bind to all interfaces in hosted containers such as Railway.
HOST=localhost

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cooee

# Auth
# Generate a unique value of at least 32 bytes before enabling authentication.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Customer-facing support destination (https:// or mailto:).
VITE_SUPPORT_URL=
# Public site linked from the dashboard.
VITE_PUBLIC_SITE_URL=http://localhost:3000

# Hosted public changelogs. Leave unset in production to use app.cooee.sh.
VITE_PUBLIC_CHANGELOG_URL=http://localhost:3000

# Optional, consent-gated product analytics. Leave blank to disable analytics.
VITE_POSTHOG_KEY=
# Optional PostHog ingestion host; defaults to the US host when a key is set.
VITE_POSTHOG_HOST=

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2

# Logo asset storage. Railway Bucket variable references expose BUCKET, ENDPOINT,
# ACCESS_KEY_ID, SECRET_ACCESS_KEY, and REGION. The API also accepts the
# AWS_* and BUCKET_* aliases shown by Railway bucket credentials and guides.
BUCKET=
ENDPOINT=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=auto
S3_FORCE_PATH_STYLE=false

# Hosted billing. Self-hosted deployments leave these unset or false.
BILLING_ENABLED=false
VITE_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional account and billing notifications.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# Optional custom-domain support.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CUSTOM_HOSTNAME_CNAME_TARGET=
